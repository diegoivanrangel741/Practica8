package figura;

class Triangulo extends Figura{
    private double base;
    private double altura;

    public Triangulo(String nombre, double base, double altura){
        super(nombre);
        this.base = base;
        this.altura = altura;
    }
    @Override
    public double calcularArea(){
        return (base * altura) / 2;
    }
    @Override
    public String toString(){
        return "TRIANGULO:" + super.toString() + "\nBase:" + base + "\nAltura:" + altura + "\nArea:" + String.format("%.2f", calcularArea()) + "\n";
    }
}
