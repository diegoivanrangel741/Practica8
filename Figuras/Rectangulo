package figura;

class Rectangulo extends Figura{
    private double base;
    private double altura;

    public Rectangulo(String nombre, double base, double altura){
        super(nombre);
        this.base = base;
        this.altura = altura;
    }
    @Override
    public double calcularArea(){
        return base * altura;
    }
    @Override
    public String toString(){
        return "RECTANGULO:" + super.toString() + "\nBase:" + base + "\nAltura:" + altura + "\nArea:" + String.format("%.2f", calcularArea()) + "\n";
    }
}
